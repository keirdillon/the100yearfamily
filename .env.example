# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Required: Resend API key (resend.com → API Keys). Without it, sign-ups return "not connected yet".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: add every new contact to this Resend Segment (e.g. "Founding Readers").
RESEND_SEGMENT_ID=

# Optional: verified sender for the welcome email. Leave blank to skip the welcome email.
# The domain must be verified in Resend first (resend.com → Domains).
RESEND_FROM_EMAIL="Jeremy Straub <jeremy@100yearos.com>"

# Optional: internal address that gets a short note for every new signup.
NOTIFY_EMAIL=
